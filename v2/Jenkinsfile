pipeline {
    agent any
    environment {
        IMAGE      = 'shivanesh77/online-exam'
        VERSION    = 'v2'
        PATH       = "C:\\Users\\SHIVANESH\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        KUBECONFIG = 'C:\\Users\\SHIVANESH\\.kube\\config'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Docker Build') {
            steps {
                dir('v2') {
                    bat 'docker build -t %IMAGE%:%VERSION% .'
                }
            }
        }
        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS')]) {
                    bat 'docker login -u %DH_USER% -p %DH_PASS%'
                    bat 'docker push %IMAGE%:%VERSION%'
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f k8s/v2.yaml'
                bat 'kubectl rollout status deployment/exam-v2 --timeout=120s'
            }
        }
    }
}
